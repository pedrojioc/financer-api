{
  "name": "avanza-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node scripts/copy-assets.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/database/data-source.ts",
    "typeorm:prod": "npx typeorm -d ./dist/src/database/data-source.js",
    "mg:generate": "npm run typeorm -- migration:generate",
    "mg:run": "npm run typeorm -- migration:run",
    "mg:run:prod": "npm run typeorm:prod -- migration:run",
    "mg:revert": "npm run typeorm -- migration:revert",
    "mg:show": "npm run typeorm -- migration:show",
    "mg:drop": "npm run typeorm -- schema:drop",
    "job:interest": "ts-node ./src/loans/jobs/daily-interests.ts",
    "job:interest:prod": "node ./dist/src/loans/jobs/daily-interests.js",
    "job:overduePayments": "ts-node ./src/loans/jobs/check-overdue-payments.ts",
    "job:overduePayments:prod": "node ./dist/src/loans/jobs/check-overdue-payments.js",
    "job:setter": "ts-node ./src/jobs/setter-script.ts",
    "job:setter:prod": "node ./dist/src/jobs/setter-script.js",
    "job:migrateToInstallments": "ts-node ./src/loans/jobs/migrate-to-daily-interest.ts",
    "job:migrateToInstallments:prod": "node ./dist/src/loans/jobs/migrate-to-daily-interest.js",
    "job:overdue-notifier": "ts-node ./src/loans/jobs/whatsapp-notifier.ts",
    "job:overdue-notifier:prod": "node ./dist/src/loans/jobs/whatsapp-notifier.js",
    "job:employees-notifier": "ts-node ./src/loans/jobs/telegram-notifier.ts",
    "job:employees-notifier:prod": "node ./dist/src/loans/jobs/telegram-notifier.js"
  },
  "dependencies": {
    "@formkit/tempo": "^0.1.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@telegraf/types": "^8.3.1",
    "argon2": "^0.41.1",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.8",
    "mysql2": "^3.9.2",
    "nestjs-telegraf": "^2.8.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "puppeteer": "^24.10.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.17",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "better-sqlite3": "^9.6.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
